{
  "headers": [
    {
      "source": "/events/:slug",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "https://uxhtnxixwusuwnudonyf.supabase.co/functions/v1/tubuy-sitemap"
    },
    {
      "source": "/events/:slug",
      "destination": "/api/event-page?slug=:slug"
    }
  ]
}